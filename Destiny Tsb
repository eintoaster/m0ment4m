    global ShowSidebarIndicators, ShowStatusNotifs, HudPosition, HudOpacity, ChkHudShow, ChkNotifShow, HudPosDDL
    
    filePath := ConfigDir "\" configName ConfigExt
    if !FileExist(filePath) {
        ShowStatus("CONFIG NOT FOUND", "0x2A0808", 500)
        return
    }
    
    try {
        content := FileRead(filePath)
        cfg := CfgFill(JsonToObj(content))
    } catch {
        ShowStatus("CONFIG LOAD ERROR", "0x2A0808", 500)
        return
    }
    
    UnregisterExt1Key(curExtender1Key)
    UnregisterExt2Key(curExtender2Key)
    UnregisterExt3Key(curExtender3Key)
    UnregisterExt4Key(curExtender4Key)
    UnregisterJumpBugKey(curJumpBugKey)
    UnregisterSystemHotkeys()
    
    IsExtender1Checked := cfg.macros.HasOwnProp("ext1") ? cfg.macros.ext1 : false
    IsExtender2Checked := cfg.macros.HasOwnProp("ext2") ? cfg.macros.ext2 : false
    IsExtender3Checked := cfg.macros.HasOwnProp("ext3") ? cfg.macros.ext3 : false
    IsExtender4Checked := cfg.macros.HasOwnProp("ext4") ? cfg.macros.ext4 : false
    IsBD1Checked       := cfg.macros.HasOwnProp("bd1") ? cfg.macros.bd1 : false
    IsBD2Checked       := cfg.macros.HasOwnProp("bd2") ? cfg.macros.bd2 : false
    IsBD3Checked       := cfg.macros.HasOwnProp("bd3") ? cfg.macros.bd3 : false
    IsBD4Checked       := cfg.macros.HasOwnProp("bd4") ? cfg.macros.bd4 : false
    IsJumpBugChecked   := cfg.macros.HasOwnProp("jump_bug") ? cfg.macros.jump_bug : false
    
    SetCheck(ChkExt1, IsExtender1Checked)
    SetCheck(ChkExt2, IsExtender2Checked)
    SetCheck(ChkExt3, IsExtender3Checked)
    SetCheck(ChkExt4, IsExtender4Checked)
    SetCheck(ChkBD1, IsBD1Checked)
    SetCheck(ChkBD2, IsBD2Checked)
    SetCheck(ChkBD3, IsBD3Checked)
    SetCheck(ChkJumpBug, IsJumpBugChecked)
    
    RobloxSensitivity := cfg.timings.HasOwnProp("roblox_sens") ? cfg.timings.roblox_sens : 0.36
    EditSens.Value := String(RobloxSensitivity)
    SensStatusText.Text := "Active sens: " RobloxSensitivity
    
    Extender1Key := cfg.keybinds.ext1_key
    Extender2Key := cfg.keybinds.ext2_key
    Extender3Key := cfg.keybinds.ext3_key
    Extender4Key := cfg.keybinds.HasOwnProp("ext4_key") ? cfg.keybinds.ext4_key : ""
    JumpBugKey   := cfg.keybinds.HasOwnProp("jump_bug_key") ? cfg.keybinds.jump_bug_key : ""
    BDSetKeysFrom(cfg.keybinds)
    XLoadFrom(cfg)
    BDPing := cfg.timings.HasOwnProp("bd_ping") ? Max(0, Min(200, Integer(cfg.timings.bd_ping))) : 0
    
    curExtender1Key := Extender1Key
    curExtender2Key := Extender2Key
    curExtender3Key := Extender3Key
    curExtender4Key := Extender4Key
    curJumpBugKey   := JumpBugKey
    
    BtnK_Ext1.Text := FormatKeyName(Extender1Key)
    BtnK_Ext2.Text := FormatKeyName(Extender2Key)
    BtnK_Ext3.Text := FormatKeyName(Extender3Key)
    BtnK_Ext4.Text := FormatKeyName(Extender4Key)
    BtnK_JumpBug.Text := FormatKeyName(JumpBugKey)
    
    ReloadKey    := cfg.system.reload_key
    MinimizeKey  := cfg.system.minimize_key
    MacroLockKey := cfg.system.lock_key
    ExitKey      := cfg.system.exit_key
    
    curReloadKey    := ReloadKey
    curMinimizeKey  := MinimizeKey
    curMacroLockKey := MacroLockKey
    curExitKey      := ExitKey
    
    BtnK_Rel.Text  := FormatKeyName(ReloadKey)
    BtnK_Min.Text  := FormatKeyName(MinimizeKey)
    BtnK_Lock.Text := FormatKeyName(MacroLockKey)
    BtnK_Exit.Text := FormatKeyName(ExitKey)
    
    RegisterHotkeys()
    RegisterSystemHotkeys()
    UpdateSidebarIndicators()
    UVisualsFrom(cfg.HasOwnProp("visuals") ? cfg.visuals : {})
    UVisualsApply()
    ShowStatus("CONFIG LOADED", "0x082A13", 500)
}


