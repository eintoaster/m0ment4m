    DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", UBrush(UCol("Pill")), "Ptr", body)
    DllCall("gdiplus\GdipDrawPath", "Ptr", UG, "Ptr", UPen(UCol("Border"), 1), "Ptr", body)
    DllCall("gdiplus\GdipDeletePath", "Ptr", body)
    WMousePart("LButton", ox + 3, oy + 3, 45, 76, 45, 4, 4, 4, gst, 0)
    WMousePart("RButton", ox + 52, oy + 3, 45, 76, 4, 45, 4, 4, gst, 0.25)
    ULine(ox + 3, oy + 84, ox + 97, oy + 84, UCol("Border"))
    UText("M1", ox + 3, oy + 50, UCol("Muted"), F_Tiny, 45, 20, 1, 1)
    UText("M2", ox + 52, oy + 50, UCol("Muted"), F_Tiny, 45, 20, 1, 1)
    ; wheel
    URR(ox + 42, oy + 20, 16, 34, 8, UCol("Card"))
    WMousePart("MButton", ox + 43, oy + 21, 14, 32, 7, 7, 7, 7, gst, 0.5)
    age := A_TickCount - WWheelAt
