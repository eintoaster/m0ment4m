}

MacroFx(*) {
    global HitOn
    if (HitOn)
        SetTimer(HitFire, -1)
}

HitFire(*) {
    global HitVig, HitShake, HitSound, HitDur, HitShakeAmt
    static last := 0
    if (A_TickCount - last < 60)
        return
    last := A_TickCount
    if (HitVig) {
        ShowHitEffect()
        SetTimer(HideHitEffect, -HitDur)
    }
    KFPlay()
    if (HitShake)
        HitShakeStart(HitDur, HitShakeAmt)
    if (HitSound)
        HitSoundPlay()
}

HitSoundPlay() {
    global HitSoundIdx, HitSoundFile, HitVol
    switch {
        case HitSoundIdx = 1: VigPlayTones([[2600, 12], [1900, 20]], HitVol)
        case HitSoundIdx = 2: VigPlayTones([[1320, 55], [1760, 120]], HitVol)
        case HitSoundIdx = 3: VigPlayTones([[700, 22], [1100, 22], [1650, 30], [2300, 70]], HitVol)
        case HitSoundIdx <= 8: VigBeepPattern(HitSoundIdx - 3, true, HitVol)
        default:
            if (HitSoundFile != "")
                VigPlayFile(HitSoundFile, HitVol)
    }
}

FxPickHitSound(i) {
    global HitSoundIdx, HitSoundFile
    if (i = 9 && HitSoundFile = "") {
        f := FxChooseFile()
        if (f = "") {
            HitSoundDDL.idx := HitSoundIdx
            return
        }
        HitSoundFile := f
    }
    HitSoundIdx := i
    HitSoundPlay()
}

FxChooseHitFile(*) {
    global HitSoundIdx, HitSoundFile
    f := FxChooseFile()
    if (f = "")
        return
    HitSoundFile := f, HitSoundIdx := 9, HitSoundDDL.idx := 9
    HitSoundPlay()
}

; the hit shake moves the game window itself a few pixels (and puts it back exactly): the game keeps running
Global HitShk := 0
OnExit(HitShakeRestore)

HitShakeStart(len, amt := 40) {
    global HitShk
    hw := WinExist(GAME_EXE)
    if (!hw)
        return
    if (!IsObject(HitShk) || HitShk.hw != hw) {
        try WinGetPos(&x, &y, , , "ahk_id " hw)
        catch
            return
        HitShk := {hw: hw, x: x, y: y}
    }
    HitShk.t0 := A_TickCount, HitShk.len := Max(80, len), HitShk.amt := amt, HitShk.ang := Random(0, 6283) / 1000
    SetTimer(HitShakeTick, 10)
}

HitShakeTick() {
    global HitShk, HitShakeStyle
    if (!IsObject(HitShk)) {
        SetTimer(HitShakeTick, 0)
        return
    }
    el := A_TickCount - HitShk.t0
    if (el >= HitShk.len || !WinExist("ahk_id " HitShk.hw)) {
        HitShakeRestore()
        return
    }
    a0 := 3 + HitShk.amt * 0.18, p := el / HitShk.len
    a := a0 * (1 - p) ** 1.4
    r() => Random(0, 2000) / 1000 - 1
    switch HitShakeStyle {
        case 2:
            k := a0 * 1.6 * Exp(-el / 90) * Cos(el / 22)
            dx := Cos(HitShk.ang) * k, dy := Sin(HitShk.ang) * k
        case 3: dx := a * 1.2 * Sin(el / 11), dy := r() * a * 0.15
        case 4: dx := r() * a * 0.15, dy := a * 1.2 * Sin(el / 11)
        case 5:
            e := a0 * 1.3 * (1 - p) ** 0.7
            dx := e * (Sin(el / 41) + 0.5 * Sin(el / 17)) / 1.5 + r() * e * 0.2
            dy := e * (Sin(el / 33 + 1) + 0.5 * Sin(el / 13)) / 1.5 + r() * e * 0.2
        case 6: dy := -a0 * 1.5 * Exp(-el / 75) + r() * a * 0.2, dx := r() * a * 0.3
        default: dx := r() * a, dy := r() * a
    }
    DllCall("SetWindowPos", "Ptr", HitShk.hw, "Ptr", 0, "Int", HitShk.x + Round(dx), "Int", HitShk.y + Round(dy), "Int", 0, "Int", 0, "UInt", 0x15)
}

HitShakeRestore(*) {
    global HitShk
    SetTimer(HitShakeTick, 0)
    if (IsObject(HitShk)) {
        try DllCall("SetWindowPos", "Ptr", HitShk.hw, "Ptr", 0, "Int", HitShk.x, "Int", HitShk.y, "Int", 0, "Int", 0, "UInt", 0x15)
        HitShk := 0
    }
}

