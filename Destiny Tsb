    UGdipInit()
    SplashBuildStars()
    g := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "Destiny closing")
    s := UMakeSurface(340, 90)
    ExitCard := {g: g, s: s, text: text, then: then, start: A_TickCount}
    ExitCardRender(0, 0)
    g.Show("x" ((A_ScreenWidth - 340) // 2) " y" ((A_ScreenHeight - 90) // 2) " w340 h90 NA")
    SetTimer(ExitCardTick, 15)
}

ExitCardTick() {
    global ExitCard
    if (!IsObject(ExitCard)) {
        SetTimer(ExitCardTick, 0)
        return
    }
    el := A_TickCount - ExitCard.start
    ExitCardRender(Min(1.0, el / 1100), el)
    if (el >= 1100) {
        SetTimer(ExitCardTick, 0)
        ExitCard.then.Call()
    }
}

ExitCardRender(t, el) {
    pc := A_IsCritical
    Critical
    try ExitCardRenderInner(t, el)
    finally Critical(pc ? "On" : "Off")
}

; t: 0..1 over the whole card
ExitCardRenderInner(t, el) {
    global ExitCard, UG, UAlpha, LogoGrad, F_B, F_Tiny
    prevG := UG, prevA := UAlpha
    UG := ExitCard.s.g, UAlpha := 1.0
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    a := Min(1.0, t * 5)
    if (t > 0.84)
        a := Max(0.0, 1 - (t - 0.84) / 0.16)
    k := 0.9 + 0.1 * UEase(t * 5)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", 170, "Float", 45, "Int", 0)
    DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", UG, "Float", k, "Float", k, "Int", 0)
    DllCall("gdiplus\GdipTranslateWorldTransform", "Ptr", UG, "Float", -170, "Float", -45, "Int", 0)
    st := GradStops(LogoGrad)
    sh := el / 1000 * 0.5
    try {
        URR(6, 12, 328, 72, 20, UC(0, 0, 0, 80))
        card := UPath(6, 6, 328, 72, 19)
        br := UGradBrush(6, 6, 328, 72, [[8, 8, 22], [24, 12, 46], [12, 7, 30]], 0)
        DllCall("gdiplus\GdipFillPath", "Ptr", UG, "Ptr", br, "Ptr", card)
        DllCall("gdiplus\GdipDeleteBrush", "Ptr", br)
        DllCall("gdiplus\GdipSetClipPath", "Ptr", UG, "Ptr", card, "Int", 0)
        UGlow(260, 20, 120, 50, 0x6D28D9, 60)
        SplashStarsDraw(6, 6, 328, 72, el * 3, 0.45)
        DllCall("gdiplus\GdipResetClip", "Ptr", UG)
        UGradBorder(6, 6, 328, 72, 19, st, sh, 2)
        ; a small orb that spins
        c := GradSample(st, -sh)
        UGlow(34, 42, 16, 16, (c[1] << 16) | (c[2] << 8) | c[3], 150)
        UDisc(34, 42, 5, UC(255, 255, 255))
        ang := el / 1000 * 5
        URing(34, 42, 11, UC(c[1], c[2], c[3], 120), 1.2)
        UDisc(34 + 11 * Cos(ang), 42 + 11 * Sin(ang), 2.2, UC(255, 255, 255))
        dots := SubStr("...", 1, Mod(Floor(el / 110), 3) + 1)
        UText(ExitCard.text dots, 58, 16, UC(243, 243, 246), F_B, 260, 24, 0, 1)
        e := 1 - (1 - Min(1.0, t * 1.08)) ** 2
        URR(58, 52, 254, 6, 3, UC(255, 255, 255, 22))
        if (e > 0.01)
            UGradFill(58, 52, Max(6, 254 * e), 6, 3, st, sh, 1.0, 254)
    }
    DllCall("gdiplus\GdipResetWorldTransform", "Ptr", UG)
    UG := prevG, UAlpha := prevA
    ULayered(ExitCard.g.Hwnd, ExitCard.s.dc, 340, 90, Round(255 * a))
}

