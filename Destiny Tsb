Global TGui := "", TS := 0, TW := 380, TH := 330, TList := [], TTimerOn := false

; ShowStatus(text, colour, x, force): the old popup call; the colour picks the look (green = on, red = off)
; cat: which switch on Visuals > Notifications allows the card ("" = worked out here: a macro firing or "system")
ShowStatus(text, colorHex, xPos := 0, force := false, cat := "") {
    global ShowStatusNotifs, TList, TH, NotifCats
    if (!ShowStatusNotifs && !force)
        return
    kind := (colorHex = "0x2A0808") ? "off" : (colorHex = "0x082A13") ? "on" : "info"
    t := Trim(StrReplace(StrReplace(text, "`r"), "`n", " "))
    title := t, sub := ""
    if (RegExMatch(t, "^(.*?):\s*(.+)$", &m))
        title := m[1], sub := Trim(m[2])
    else if (kind = "on" && xPos <= 300 && !force)
        sub := "fired", kind := "fire"
    if (cat = "")
        cat := (kind = "fire") ? "fire" : "system"
    if (!force && !NotifCats.Get(cat, true))
        return
    if (title == StrUpper(title))
        title := StrTitle(StrLower(title))
    for it in TList {
        if (it.title = title) {
            it.sub := sub, it.kind := kind, it.t0 := A_TickCount - 300
            TStart()
            return
        }
    }
    TList.InsertAt(1, {title: title, sub: sub, kind: kind, t0: A_TickCount, dur: 2200, y: TH - 70})
    while (TList.Length > 4)
        TList.Pop()
    TStart()
}

TStart() {
    global TGui, TS, TW, TH, TTimerOn
    if (!IsObject(TGui)) {
        UGdipInit()
        TGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "Destiny notifications")
        TS := UMakeSurface(TW, TH)
    }
    TGui.Show("x" (A_ScreenWidth - TW) " y" (A_ScreenHeight - TH - 48) " w" TW " h" TH " NA")
    if (!TTimerOn) {
        TTimerOn := true
        SetTimer(TTick, 16)
    }
}

TTick() {
    global TList, TGui, TTimerOn
    now := A_TickCount
    i := TList.Length
    while (i >= 1) {
        if (now - TList[i].t0 > TList[i].dur + 420)
            TList.RemoveAt(i)
        i--
    }
    if (TList.Length = 0) {
        SetTimer(TTick, 0)
        TTimerOn := false
        TGui.Hide()
        return
    }
    pc := A_IsCritical
    Critical
    try TRender()
    finally Critical(pc ? "On" : "Off")
}

TRender() {
    global TList, TS, TW, TH, TGui, UG, UAlpha, F_B, F_Sm, F_Icon
    prevG := UG, prevA := UAlpha
    UG := TS.g
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    now := A_TickCount
    cw := 330, ch := 60
    for i, it in TList {
        target := TH - 14 - ch - (i - 1) * (ch + 10)
        it.y += (target - it.y) * 0.3
        el := now - it.t0
        tin := Max(0.0, Min(1.0, el / 460))
        e := 1 + 2.70158 * (tin - 1) ** 3 + 1.70158 * (tin - 1) ** 2
        tout := (el > it.dur) ? Min(1.0, (el - it.dur) / 400) ** 2 : 0.0
        x := TW - cw - 16 + (1 - e) * (cw + 30) + tout * (cw + 30)
        y := it.y
        UAlpha := Min(1.0, tin * 2.5) * (1 - tout)
        rc := (it.kind = "off") ? UPal("Red") : GradSample(GradStops(1), now / 1000 * 0.1 + i * 0.15)
        col := UC(rc[1], rc[2], rc[3])
        URR(x - 1, y + 4, cw + 2, ch, 15, UC(0, 0, 0, 60))
        URR(x, y, cw, ch, 14, UCol("Card"))
        UGradFill(x, y, cw, ch, 14, [rc, UPal("Card")], 0, 0.10, cw * 2)
        URRLine(x, y, cw, ch, 14, UCol("Border"))
        URR(x + 14, y + 14, 32, 32, 10, UC(rc[1], rc[2], rc[3], 40))
        icon := (it.kind = "off") ? Chr(0xE711) : (it.kind = "on") ? Chr(0xE73E) : (it.kind = "fire") ? Chr(0xE945) : Chr(0xE946)
        UText(icon, x + 14, y + 14, col, F_Icon, 32, 32, 1, 1)
        if (it.sub = "")
            UText(it.title, x + 58, y, UCol("Text"), F_B, cw - 72, ch, 0, 1)
        else {
            UText(it.title, x + 58, y + 10, UCol("Text"), F_B, cw - 72, 20, 0, 1)
            UText(it.sub, x + 58, y + 30, UCol("Text2"), F_Sm, cw - 72, 18, 0, 1)
        }
        rem := Max(0.0, 1 - el / it.dur)
        if (it.kind = "off")
            URR(x + 16, y + ch - 6, (cw - 32) * rem, 2.5, 1.25, UC(rc[1], rc[2], rc[3], 170))
        else
            UGradFill(x + 16, y + ch - 6, (cw - 32) * rem, 2.5, 1.25, GradStops(1), now / 1000 * 0.3, 0.8, cw - 32)
    }
    UG := prevG, UAlpha := prevA
    ULayered(TGui.Hwnd, TS.dc, TW, TH)
}


Global RecState := "idle"
Global RecEvents := [], RecT0 := 0, RecQHold := 0, RecArmedAt := 0, RecGui := 0
Global RecLen := 900
Global RecRawWant := false
Global RecMsg := "", RecMenuWasOpen := false, URecLive := false
; loaded recordings: {name, file, sens, qhold, events, enabled, key, box, land, fine, speed, amount, curve, peak, summary}
Global SolRecs := []
Global RecKeysOn := []
Global RecDirty := Map()
Global UPatternDir := RegExReplace(ConfigDir, "\\configs$") "\recordings"
if (!DirExist(UPatternDir)) {
    old := RegExReplace(ConfigDir, "\\configs$") "\patterns"
    if (DirExist(old))
        try DirMove(old, UPatternDir)
    try DirCreate(UPatternDir)
}

; milliseconds from the performance counter (sub-millisecond)
QMs() {
    static f := 0
    if (!f)
        DllCall("QueryPerformanceFrequency", "Int64*", &f)
    c := 0
    DllCall("QueryPerformanceCounter", "Int64*", &c)
    return c * 1000 / f
}

; how long a wait really took in the old AutoHotkey v1 script of Instant Lethal: v1 waits on Windows' coarse clock (15.625 ms ticks),
; so a Sleep rounds up to the next tick (Sleep 1 = 15.6 ms, Sleep 130 = 140.6 ms). Its Send also waits 10 ms after
; every key (no SendMode / SetKeyDelay in that script), which rounds up to 15.6 ms too: V1Sleep(10).
V1Sleep(n) => Ceil(n / 15.625) * 15.625

; waits until t ms after base (sub-millisecond)
QWaitUntil(base, t) {
    while (QMs() - base < t) {
        if (t - (QMs() - base) > 2)
            DllCall("Sleep", "UInt", 1)
    }
}

; raw input (the real counts from the mouse, no pointer speed or acceleration), also while Roblox has the focus
; the recorder asks for raw input with RecRawOn; the camera turn widget sets WRawWant; RawSync registers what is needed
RecRawOn(on) {
    global RecRawWant
    RecRawWant := on
    return RawSync()
}

RawSync() {
    global RecGui, RecRawWant, WRawWant
    if (!IsObject(RecGui)) {
        RecGui := Gui("+ToolWindow -Caption", "Destiny recorder")
        OnMessage(0x00FF, RecOnInput)
    }
    ; mouse: recorder or camera turn; keyboard: recorder only (Q and the mouse from one clock, in order)
    sz := 8 + A_PtrSize
    rid := Buffer(sz * 2, 0)
    for i, want in [RecRawWant || WRawWant, RecRawWant] {
        o := (i - 1) * sz
        NumPut("UShort", 1, rid, o), NumPut("UShort", i = 1 ? 2 : 6, rid, o + 2)
        NumPut("UInt", want ? 0x100 : 0x1, rid, o + 4)
        NumPut("Ptr", want ? RecGui.Hwnd : 0, rid, o + 8)
    }
    ok := true
    Loop 2 {
        r := DllCall("RegisterRawInputDevices", "Ptr", rid.Ptr + (A_Index - 1) * sz, "UInt", 1, "UInt", sz)
        if (A_Index = 1 && (RecRawWant || WRawWant))
            ok := r
    }
    return ok
}

RecOnInput(wParam, lParam, msg, hwnd) {
    global RecState, RecEvents, RecT0, RecQHold, WRawWant, WTurnAcc, WWheelAt, WWheelDir
    static buf := Buffer(64, 0)
    if (RecState = "idle" && !WRawWant)
        return
    hdr := 8 + 2 * A_PtrSize
    sz := buf.Size
    if (DllCall("GetRawInputData", "Ptr", lParam, "UInt", 0x10000003, "Ptr", buf, "UInt*", &sz, "UInt", hdr) <= 0)
        return
    t := QMs()
    kind := NumGet(buf, 0, "UInt")
    if (kind = 1) {
        if (RecState = "idle" || NumGet(buf, hdr + 6, "UShort") != 0x51)
            return
        up := NumGet(buf, hdr + 2, "UShort") & 1
        if (!up && RecState = "armed" && WinActive(GAME_EXE)) {
            RecT0 := t, RecQHold := 0, RecEvents := []
            RecState := "recording"
        } else if (up && RecState = "recording" && !RecQHold)
            RecQHold := Max(1, Round(t - RecT0))
        return
    }
    if (kind != 0 || (NumGet(buf, hdr, "UShort") & 1))
        return
    dx := NumGet(buf, hdr + 12, "Int")
    if (WRawWant) {
        WTurnAcc += dx
        if (NumGet(buf, hdr + 4, "UShort") & 0x0400)
            WWheelAt := A_TickCount, WWheelDir := NumGet(buf, hdr + 6, "Short") > 0 ? 1 : -1
    }
    if (RecState = "recording" && dx)
        RecEvents.Push([t, dx, NumGet(buf, hdr + 16, "Int")])
}

; Record new / Cancel
RecArm(*) {
    global RecState, RecEvents, RecArmedAt, RecMsg, RecMenuWasOpen, isAppMinimized
    if (RecState != "idle") {
        RecStop()
        RecMsg := "Cancelled."
        return
    }
    if (!WinExist(GAME_EXE)) {
        RecMsg := "Start Roblox first."
        UNotify("Recorder", "start Roblox first", false, "system")
        return
    }
    if (!RecRawOn(true)) {
        RecMsg := "Could not read the mouse (raw input refused)."
        return
    }
    RecEvents := [], RecState := "armed", RecArmedAt := A_TickCount
    RecMsg := ""
    UNotify("Recorder", "go in game and do the dash (Esc cancels)", true, "system")
    RecMenuWasOpen := !isAppMinimized
    if (RecMenuWasOpen) {
        isAppMinimized := true
        UEditStop()
        UHideNow()
    }
    SetTimer(RecWatch, 20)
}

RecStop() {
    global RecState, RecMenuWasOpen, isAppMinimized
    RecState := "idle"
    SetTimer(RecWatch, 0)
    RecRawOn(false)
    if (RecMenuWasOpen && isAppMinimized) {
        RecMenuWasOpen := false
        ToggleMainGui()
    }
    HudRequest()
    UReq()
}

RecWatch() {
    global RecState, RecArmedAt, RecT0, RecLen, RecMsg
    if (RecState = "armed" && GetKeyState("Escape", "P")) {
        RecStop()
        RecMsg := "Cancelled."
        return
    }
    if (RecState = "armed" && A_TickCount - RecArmedAt > 60000) {
        RecStop()
        RecMsg := "Timed out - no Q press in 60 s."
        return
    }
    if (RecState = "recording" && QMs() - RecT0 >= RecLen)
        RecFinish()
}

RecFinish() {
    global RecEvents, RecT0, RecQHold, RecLen, RecMsg, RobloxSensitivity, UPatternDir
    ev := RecEvents
    RecStop()
    out := []
    for e in ev {
        t := e[1] - RecT0
        if (t >= 0 && t <= RecLen)
            out.Push([Round(t, 1), e[2], e[3]])
    }
    if (out.Length = 0) {
        RecMsg := "No mouse movement was recorded. Try again."
        UNotify("Recorder", "nothing recorded", false, "system")
        return
    }
    try DirCreate(UPatternDir)
    n := 1
    while (FileExist(UPatternDir "\Dash " n ".txt"))
        n++
    rec := RecNew("Dash " n)
    rec.sens := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    rec.qhold := RecQHold ? RecQHold : 60
    rec.events := out
    if (!RecSave(rec)) {
        RecMsg := "Could not save the recording."
        return
    }
    RecLoadAll()
    for r in SolRecs
        if (r.name = rec.name)
            rec := r
    RecMsg := "Saved " rec.name " - switch it on and give it a key below."
    UNotify("Recorded", rec.name " - " rec.summary, true, "system")
}

; a recording with the default settings
RecNew(name) {
    global UPatternDir
    return {name: name, file: UPatternDir "\" name ".txt", sens: 0.36, qhold: 60, events: [], enabled: false, key: ""
        , box: UVal("NONE"), speed: 100, amount: 100, running: false, hasSettings: false, owner: ""}
}

RecOwnerId() => A_ComputerName "/" A_UserName

; writes a recording: its settings first, then the moves (time, x, y)
RecSave(rec) {
    txt := "sens=" USens(rec.sens) "`nqhold=" rec.qhold "`nowner=" RecOwnerId() "`nenabled=" (rec.enabled ? 1 : 0) "`nkey=" rec.key
        . "`nspeed=" rec.speed "`namount=" rec.amount "`n"
    for e in rec.events
        txt .= Format("{:.1f}", e[1]) " " e[2] " " e[3] "`n"
    try {
        f := FileOpen(rec.file, "w", "UTF-8")
        f.Write(txt)
        f.Close()
        rec.hasSettings := true
        return true
    }
    return false
}

; settings changes are written a moment later in one go (a slider drag does not rewrite the file every step)
RecSaveSoon(rec) {
    global RecDirty
    RecDirty[rec.file] := rec
    SetTimer(RecFlush, -600)
}
RecFlush() {
    global RecDirty
    for f, rec in RecDirty
        RecSave(rec)
    RecDirty := Map()
}

; reads every recording and switches their keys on
RecLoadAll() {
    global SolRecs, UPatternDir, UPrefsFile
    RecFlush()
    SolRecs := []
    files := []
    Loop Files UPatternDir "\*.txt"
        files.Push(A_LoopFileFullPath)
    for path in files {
        rec := RecLoad(path)
        if (!IsObject(rec))
            continue
        if (!rec.hasSettings) {
            try {
                rec.speed := Max(50, Min(150, Integer(IniRead(UPrefsFile, "solitude", "speed", 100))))
                rec.amount := Max(50, Min(150, Integer(IniRead(UPrefsFile, "solitude", "amount", 100))))
            }
            RecSave(rec)
        }
        SolRecs.Push(rec)
    }
    RegisterHotkeys()
    HudRequest()
}

RecLoad(path) {
    SplitPath(path, , , , &name)
    try txt := FileRead(path, "UTF-8")
    catch
        return 0
    rec := RecNew(name)
    rec.file := path
    Loop Parse txt, "`n", "`r" {
        line := Trim(A_LoopField)
        if (line = "")
            continue
        if (RegExMatch(line, "^(\w+)=(.*)$", &m)) {
            v := m[2]
            try {
              switch m[1] {
                case "sens": rec.sens := Float(v)
                case "qhold": rec.qhold := Integer(v)
                case "enabled": rec.enabled := (v = "1")
                case "key": rec.key := v
                case "owner": rec.owner := v
                case "land": rec.hasSettings := true
                case "speed": rec.speed := Max(50, Min(150, Integer(v))), rec.hasSettings := true
                case "amount": rec.amount := Max(50, Min(150, Integer(v))), rec.hasSettings := true
              }
            }
            continue
        }
        p := StrSplit(line, " ")
        if (p.Length >= 3)
            try rec.events.Push([Float(p[1]), Integer(p[2]), Integer(p[3])])
    }
    if (rec.events.Length = 0)
        return 0
    if (rec.owner != "" && rec.owner != RecOwnerId())
        rec.enabled := false, rec.key := ""
    if (rec.key = "LButton")
        rec.key := ""
    rec.box := UVal(FormatKeyName(rec.key))
    RecAnalyse(rec)
    return rec
}

; the camera turn over time (degrees, + = right) in 10 ms steps, and a short summary
RecAnalyse(rec) {
    k := rec.sens / 2.5
    ev := rec.events
    t0 := Floor(Min(0, ev[1][1]) / 10) * 10, t1 := Ceil(ev[ev.Length][1] / 10) * 10
    curve := [], cum := 0, i := 1, peak := 0
    t := t0
    while (t <= t1) {
        while (i <= ev.Length && ev[i][1] <= t) {
            cum += ev[i][2] * k
            i++
        }
        curve.Push([t, cum])
        peak := Max(peak, Abs(cum))
        t += 10
    }
    rec.curve := curve, rec.peak := peak, rec.t0 := t0, rec.t1 := t1
    total := cum
    sx := 0, sa := 0
    for e in ev
        if (e[1] >= 0)
            sx += e[2], sa += Abs(e[2])
    rec.sumdx := sx, rec.sumabs := sa, rec.totalDeg := total
    ; turn starts where 5 % of the biggest turn is reached (after Q), ends at 95 %
    st := "", en := ""
    for c in curve {
        if (c[1] < 0)
            continue
        if (st = "" && Abs(c[2]) >= 0.05 * peak)
            st := c[1]
        if (en = "" && Abs(c[2]) >= 0.95 * peak)
            en := c[1]
    }
    rec.summary := Round(Abs(total)) " deg " ((total < 0) ? "left" : "right")
    if (st != "" && en != "")
        rec.summary .= ", starts " Round(st) " ms after Q, takes " Round(en - st) " ms"
}


; switches every recording's key on (or off when it is switched off / the macro lock is on); called by RegisterHotkeys
RecRegisterAll() {
    global SolRecs, RecKeysOn, IsMacrosLocked
    for key in RecKeysOn
        MacroKeyOff(key)
    RecKeysOn := []
    for rec in SolRecs {
        if (rec.key = "")
            continue
        MacroKey(rec.key, RecFire.Bind(rec), rec.enabled && !IsMacrosLocked)
        RecKeysOn.Push(rec.key)
    }
}

MacroKeyOff(key, prefix := "") {
    if (key = "")
        return
    HotIfWinActive(GAME_EXE)
    try Hotkey(prefix "*" key, "Off")
    HotIf()
}

RecFire(rec, *) {
    global IsMacrosLocked
    if (!rec.enabled || IsMacrosLocked || rec.running || !WinActive(GAME_EXE))
        return
    rec.running := true
    try SolReplay(rec)
    rec.running := false
    MacroFx()
    SetTimer(ShowStatus.Bind(rec.name, "0x082A13", 300), -1)
    SetTimer(HudFlash.Bind("rec:" rec.name), -1)
}

; where a recording should end: the nearest whole number of full turns (0 = back where it started), plus the
; fine-tune (+ = more to the right, - = more to the left)
; replays a recording: Q at once, the side-to-side mouse moves at their recorded moments
SolReplay(rec) {
    global RobloxSensitivity
    sens := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    k := (rec.sens / sens) * rec.amount / 100
    tk := 100 / rec.speed
    ev := rec.events
    i := 1
    while (i <= ev.Length && ev[i][1] < 0)
        i++
    SendInput("{q down}")
    base := QMs()
    qUp := false, qUpAt := Max(5, rec.qhold * tk)
    ax := 0.0
    Loop {
        now := QMs() - base
        if (!qUp && now >= qUpAt) {
            SendInput("{q up}")
            qUp := true
        }
        while (i <= ev.Length && ev[i][1] * tk <= now) {
            ax += ev[i][2] * k
            i++
        }
        mx := Round(ax)
        if (mx) {
            DllCall("mouse_event", "UInt", 0x01, "Int", mx, "Int", 0, "UInt", 0, "UPtr", 0)
            ax -= mx
        }
        if (i > ev.Length && qUp)
            break
        DllCall("Sleep", "UInt", 1)
    }
}


