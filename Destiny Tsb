MacroLockToggle(*) {
    global IsMacrosLocked, DestinyAccent
    global IsExtender1Checked, IsExtender2Checked, IsExtender3Checked, IsExtender4Checked
    global IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked, IsJumpBugChecked
    global SavedExt1Checked, SavedExt2Checked, SavedExt3Checked, SavedExt4Checked
    global SavedBD1Checked, SavedBD2Checked, SavedBD3Checked, SavedBD4Checked, SavedJumpBugChecked
    global ChkExt1, ChkExt2, ChkExt3, ChkExt4, ChkBD1, ChkBD2, ChkBD3, ChkJumpBug, HudDots
    
    if (IsMacrosLocked) {
        IsExtender1Checked := SavedExt1Checked
        IsExtender2Checked := SavedExt2Checked
        IsExtender3Checked := SavedExt3Checked
        IsExtender4Checked := SavedExt4Checked
        IsBD1Checked       := SavedBD1Checked
        IsBD2Checked       := SavedBD2Checked
        IsBD3Checked       := SavedBD3Checked
        IsBD4Checked       := SavedBD4Checked
        IsJumpBugChecked   := SavedJumpBugChecked
        
        SetCheck(ChkExt1, IsExtender1Checked)
        SetCheck(ChkExt2, IsExtender2Checked)
        SetCheck(ChkExt3, IsExtender3Checked)
        SetCheck(ChkExt4, IsExtender4Checked)
        SetCheck(ChkBD1, IsBD1Checked)
        SetCheck(ChkBD2, IsBD2Checked)
        SetCheck(ChkBD3, IsBD3Checked)
        SetCheck(ChkJumpBug, IsJumpBugChecked)
        
