Global OreoRec := ""

OreoRecording() {
    global OreoRec, OreoData
    if (!IsObject(OreoRec)) {
        ev := []
        for pair in StrSplit(RegExReplace(Trim(OreoData), "\s+", " "), " ") {
            p := StrSplit(pair, ":")
            ev.Push([Float(p[1]), Integer(p[2]), 0])
        }
        OreoRec := {sens: 0.36, qhold: 65, speed: 102, amount: 100, events: ev}
    }
    return OreoRec
}

XRun(i, *) {
    global XMac, RobloxSensitivity
    m := XMac[i]
    if (!m.on || m.running || !WinActive(GAME_EXE))
        return
    m.running := true
    if (m.id = "oreo") {
        SolReplay(OreoRecording())
        m.running := false
        SetTimer(ShowStatus.Bind("OREO", "0x082A13", 300), -1)
        SetTimer(HudFlash.Bind(m.id), -1)
        MacroFx()
        return
    }
    s := XSchedule(i)
    k := s.sens / ((RobloxSensitivity > 0) ? RobloxSensitivity : 0.36)
    ev := s.ev, j := 1, ax := 0.0
    qd := s.HasOwnProp("qd") ? s.qd : 0, qu := s.HasOwnProp("qu") ? s.qu : 10
    base := QMs()
    qDown := false, qUp := false
    Loop {
        now := QMs() - base
        if (!qDown && now >= qd) {
            SendInput("{q down}")
            qDown := true
        }
        if (qDown && !qUp && now >= qu) {
            SendInput("{q up}")
            qUp := true
        }
        while (j <= ev.Length && ev[j][1] <= now) {
            ax += ev[j][2] * k
            j++
        }
        mx := Round(ax)
        if (mx) {
            DllCall("mouse_event", "UInt", 0x01, "Int", mx, "Int", 0, "UInt", 0, "UPtr", 0)
            ax -= mx
        }
        if (j > ev.Length && qUp)
            break
        DllCall("Sleep", "UInt", 1)
    }
    m.running := false
    SetTimer(ShowStatus.Bind(StrUpper(m.name), "0x082A13", 300), -1)
    SetTimer(HudFlash.Bind(m.id), -1)
    MacroFx()
}

XToggle(i, *) {
    global XMac
    XMac[i].on := !XMac[i].on
    UpdateSidebarIndicators()
}

XRegisterAll() {
    global XMac, XKeysOn
    for key in XKeysOn
        MacroKeyOff(key)
    XKeysOn := []
    for i, m in XMac {
        if (m.key = "")
            continue
        MacroKey(m.key, XRun.Bind(i), m.on)
        XKeysOn.Push(m.key)
    }
}

StartBindX(i, *) {
    global XMac
    m := XMac[i]
    KeyWait("LButton")
    old := m.key
    m.box.Text := "[ Press Key... ]"
    Hotkey("~*Escape", CancelBind, "On")
    key := InputKeyOrMouse()
    try Hotkey("~*Escape", CancelBind, "Off")
    if (key = "Cancel")
        key := old
    MacroKeyOff(old)
    m.key := (key = "Escape") ? "" : key
    m.box.Text := FormatKeyName(m.key)
    RegisterHotkeys()
    HudRequest()
}

; macro lock: off while locked, back as they were after
XLock(lock) {
    global XMac
    for m in XMac {
        if (lock)
            m.saved := m.on, m.on := false
        else
            m.on := m.saved
    }
}

; configs: on / off and keys
XSaveTo(cfg) {
    global XMac
    for m in XMac {
        nm := m.id, kn := m.id "_key"
        cfg.macros.%nm% := m.on ? 1 : 0
        cfg.keybinds.%kn% := m.key
    }
}

XLoadFrom(cfg) {
    global XMac
    mc := cfg.HasOwnProp("macros") ? cfg.macros : {}
    kb := cfg.HasOwnProp("keybinds") ? cfg.keybinds : {}
    for m in XMac {
        nm := m.id, kn := m.id "_key"
        m.on := mc.HasOwnProp(nm) ? (mc.%nm% ? true : false) : false
        m.key := kb.HasOwnProp(kn) ? kb.%kn% : ""
        m.box.Text := FormatKeyName(m.key)
    }
}

ExecuteExtender4(*) {
    global isExtender4Running, RobloxSensitivity, BaseSensitivity
    if (!IsExtender4Checked || isExtender4Running || !WinActive(GAME_EXE))
        return
    isExtender4Running := true
    SetTimer(() => ShowStatus("DRIPZ TECH", "0x082A13", 250), -1)
    SetTimer(() => BlinkIndicator(4), -1)
    
    a2 := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    b2 := (BaseSensitivity > 0) ? BaseSensitivity : 0.8
    postQDelay := 160
    flick := 1260
    flickSteps := 12
    flickStepDelay := 6
    correction := 120
    correctionDelay := 4
    
    ; === 1. Tap Q right away - dash fires FORWARD (no uppercut / M1 / jump first) ===
    SendInput("{q down}")
    DllCall("Sleep", "UInt", 5)
    SendInput("{q up}")
    
    ; === 2. Fly short distance (dripz tight timing) ===
    DllCall("Sleep", "UInt", postQDelay)
    
    ; === 3. Continuous Smooth Orbital Curve ===
    scaledFlick := Round(flick * (b2 / a2))
    perStep := Round(scaledFlick / flickSteps)
    
    Loop flickSteps {
        DllCall("mouse_event", "UInt", 0x01, "Int", perStep, "Int", 0, "UInt", 0, "UPtr", 0)
        DllCall("Sleep", "UInt", flickStepDelay)
    }
    
    ; === 4. Micro Landing Alignment ===
    if (correction != 0) {
        DllCall("Sleep", "UInt", correctionDelay)
        scaledCorr := Round(correction * (b2 / a2))
        DllCall("mouse_event", "UInt", 0x01, "Int", scaledCorr, "Int", 0, "UInt", 0, "UPtr", 0)
    }
    
    isExtender4Running := false
    MacroFx()
}

ExecuteJumpBug(*) {
    global isJumpBugRunning
    if (!IsJumpBugChecked || isJumpBugRunning || !WinActive(GAME_EXE))
        return
    isJumpBugRunning := true
    ShowStatus("JUMP BUG", "0x082A13", 150)
    BlinkIndicator(5)
    
    SendInput("{d down}{Space down}{q down}")
    Sleep(100)
    SendInput("{d up}{Space up}{q up}")
    
    isJumpBugRunning := false
    MacroFx()
}


