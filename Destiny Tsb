ExecuteExtender1(*) {
    global isExtender1Running, RobloxSensitivity, BaseSensitivity
    if (!IsExtender1Checked || isExtender1Running || !WinActive(GAME_EXE))
        return
    isExtender1Running := true
    ShowStatus("INSTANT LETHAL", "0x082A13", 100)
    BlinkIndicator(1)
    
    ; Sensitivity scaling (OREO Instant Lethal): the flick is 1360 x 0.8 / your sens (3022 at 0.36)
    a2 := (RobloxSensitivity > 0) ? RobloxSensitivity : 0.36
    b2 := (BaseSensitivity > 0) ? BaseSensitivity : 0.8
    l1 := Round(1360 * (b2 / a2))

    ; Straight dash, timed like the v1 script ran it (see V1Sleep):
    ; Sleep 16, Sleep 130, flick; each Send waits a key delay after it
    kd := V1Sleep(10)
    base := QMs()
    Send("{Space down}")
    QWaitUntil(base, kd + V1Sleep(1))
    Send("{q down}")
    QWaitUntil(base, 2 * kd + V1Sleep(1))
    Send("{q up}")
    QWaitUntil(base, 3 * kd + V1Sleep(1))
    Send("{Space up}")
    QWaitUntil(base, 4 * kd + V1Sleep(1) + V1Sleep(16) + V1Sleep(130) - 20)
    DllCall("mouse_event", "UInt", 0x0001, "Int", l1, "Int", 0, "UInt", 0, "UPtr", 0)

    isExtender1Running := false
    MacroFx()
}

; --- Macro 2: Instant Twisted (made on 0.2 sens)
ExecuteExtender2(*) {
    global isExtender2Running, RobloxSensitivity
    if (!IsExtender2Checked || isExtender2Running || !WinActive(GAME_EXE))
        return
    isExtender2Running := true
    k := 0.2 / ((RobloxSensitivity > 0) ? RobloxSensitivity : 0.36)
    qu := 70
    ev := []
    for grp in [[70, -715], [150, 1605], [230, -890]]
        Loop 5
            ev.Push([grp[1] + (A_Index - 1) * 10, grp[2] / 5])
    SendInput("{q down}")
    base := QMs()
    qUp := false, j := 1, ax := 0.0
    Loop {
        now := QMs() - base
        if (!qUp && now >= qu) {
            SendInput("{q up}")
            qUp := true
        }
        while (j <= ev.Length && ev[j][1] <= now) {
            ax += ev[j][2] * k
            j++
        }
        mx := Round(ax)
        if (mx) {
            DllCall("mouse_event", "UInt", 0x01, "Int", mx, "Int", 0, "UInt", 0, "UPtr", 0)
            ax -= mx
        }
        if (j > ev.Length && qUp)
            break
        DllCall("Sleep", "UInt", 1)
    }
    isExtender2Running := false
    MacroFx()
    SetTimer(ShowStatus.Bind("INSTANT TWISTED", "0x082A13", 200), -1)
    SetTimer(BlinkIndicator.Bind(2), -1)
}

; --- Backdash 1-4: 
; The backdash key itself also goes through to the game, not sure  (~). BDPing ("Ping timing"): S + Q come that many ms after
; the skill - with a very low ping the backdash sometimes did not take, with a higher ping it did.
ExecuteBackdash(n, *) {
    global BDRunning, IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked
    if (![IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked][n] || BDRunning[n] || !WinActive(GAME_EXE))
        return
    global BDPing
    BDRunning[n] := true
    if (BDPing <= 0) {
        Send("{" n " down}{s down}{q down}")
        Send("{" n " up}")
    } else {
        t0 := QMs()
        Send("{" n " down}")
        Send("{" n " up}")
        while (QMs() - t0 < BDPing)
            DllCall("Sleep", "UInt", (BDPing - (QMs() - t0)) > 2 ? 1 : 0)
        Send("{s down}{q down}")
    }
    Sleep(100)
    Send("{s up}{q up}")
    BDRunning[n] := false
    SetTimer(ShowStatus.Bind("BACKDASH " n, "0x082A13", 300), -1)
    SetTimer(HudFlash.Bind("bd" n), -1)
    MacroFx()
}

