; an older or hand-edited config may miss parts: they get the defaults, so loading never stops halfway
CfgFill(cfg) {
    if (!IsObject(cfg) || Type(cfg) != "Object")
        throw Error("not a config")
    defs := Map("macros", Map(), "timings", Map()
        , "keybinds", Map("ext1_key", "", "ext2_key", "", "ext3_key", "")
        , "system", Map("reload_key", "Insert", "minimize_key", "F8", "lock_key", "F5", "exit_key", "Delete"))
    for sec, keys in defs {
        if (!cfg.HasOwnProp(sec) || !IsObject(cfg.%sec%))
            cfg.%sec% := {}
        for k, v in keys
            if (!cfg.%sec%.HasOwnProp(k))
                cfg.%sec%.%k% := v
    }
    return cfg
}

