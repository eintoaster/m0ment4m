    o := {idle: WIdle ? 1 : 0}
    for id, wd in Widgets
        o.%id% := {on: wd.on ? 1 : 0, bg: wd.bg ? 1 : 0, border: wd.bstyle, grad: wd.grad, size: wd.scale}
    return o
