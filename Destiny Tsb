        IsExtender2Checked := false
        IsExtender3Checked := false
        IsExtender4Checked := false
        IsBD1Checked       := false
        IsBD2Checked       := false
        IsBD3Checked       := false
        IsBD4Checked       := false
        IsJumpBugChecked   := false
        
        SetCheck(ChkExt1, false)
        SetCheck(ChkExt2, false)
        SetCheck(ChkExt3, false)
        SetCheck(ChkExt4, false)
