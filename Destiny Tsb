        cy := WWheelDir > 0 ? oy + 13 : oy + 61, d := WWheelDir > 0 ? -1 : 1
        ULine(ox + 44, cy - 3 * d, ox + 50, cy + 3 * d, UC(c[1], c[2], c[3], Round(255 * wt)), 2.2)
        ULine(ox + 56, cy - 3 * d, ox + 50, cy + 3 * d, UC(c[1], c[2], c[3], Round(255 * wt)), 2.2)
