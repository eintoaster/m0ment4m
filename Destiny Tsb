LoadProfileInner(configName) {
    global ConfigDir, ConfigExt, BDPing
    global IsExtender1Checked, IsExtender2Checked, IsExtender3Checked, IsExtender4Checked
    global IsBD1Checked, IsBD2Checked, IsBD3Checked, IsBD4Checked, IsJumpBugChecked
    global RobloxSensitivity
    global Extender1Key, Extender2Key, Extender3Key, Extender4Key, JumpBugKey
    global curExtender1Key, curExtender2Key, curExtender3Key, curExtender4Key, curJumpBugKey
    global ReloadKey, MinimizeKey, MacroLockKey, ExitKey
    global curReloadKey, curMinimizeKey, curMacroLockKey, curExitKey
    global BtnK_Ext1, BtnK_Ext2, BtnK_Ext3, BtnK_Ext4, BtnK_JumpBug
    global BtnK_Lock, BtnK_Min, BtnK_Rel, BtnK_Exit
