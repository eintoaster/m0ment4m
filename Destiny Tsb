        SetTimer(KFPlay, -150)
}

; one extra effect, a random one when Random is chosen (never the same twice in a row)
KFPlay(*) {
    global HitKFIdx
    static last := 0
    idx := HitKFIdx
    if (idx <= 1)
        return
    if (idx = 2) {
        Loop
            idx := Random(3, 9)
        until (idx != last)
    }
    last := idx
    KFStart(idx - 1)
}

; the hit effect's colours: two shades (the second for highlights)
KFHitCols() {
    global HitKFCol, LogoGrad, AccentColor
    switch HitKFCol {
        case 2:
            st := GradStops(LogoGrad), t := A_TickCount / 1000
            return [GradSample(st, t * 0.3), GradSample(st, t * 0.3 + 0.45)]
        case 3:
            a := UHexArr(AccentColor)
            return [a, KFShade(a, 0.35)]
        case 4: return [[255, 255, 255], [190, 215, 255]]
        default: return [[255, 36, 56], [255, 128, 96]]
    }
}

; lighter (f > 0) or darker (f < 0)
KFShade(c, f) => (f >= 0) ? [Round(c[1] + (255 - c[1]) * f), Round(c[2] + (255 - c[2]) * f), Round(c[3] + (255 - c[3]) * f)]
    : [Round(c[1] * (1 + f)), Round(c[2] * (1 + f)), Round(c[3] * (1 + f))]

; starts one effect (all random parts are decided here, so every time looks a bit different)
KFStart(style) {
    global KFGui, KFS, KFState, HitDur
    W := A_ScreenWidth, H := A_ScreenHeight, k := Min(W, H) / 1080
    if (!IsObject(KFGui)) {
        UGdipInit()
        KFGui := Gui("+AlwaysOnTop -Caption +ToolWindow +E0x80000 +E0x20 +E0x08000000 -DPIScale", "Destiny extra effect")
        KFS := UMakeSurface(W, H)
    }
    st := {style: style, t0: A_TickCount, dur: Max(380, Round(HitDur * 1.3)), W: W, H: H, k: k, lines: 0, lineAt: -1}
    switch style {
        case 3:
            st.blobs := []
            Loop 6 {
                side := Random(1, 4)
                x := (side = 1) ? Random(0.0, 0.16) * W : (side = 2) ? W - Random(0.0, 0.16) * W : Random(0.05, 0.95) * W
                y := (side = 3) ? Random(0.0, 0.18) * H : (side = 4) ? H - Random(0.0, 0.18) * H : Random(0.05, 0.95) * H
                b := {x: x, y: y, r: Random(55, 135) * k, sats: [], drips: []}
                Loop 9
                    b.sats.Push([Random(-1.7, 1.7) * b.r, Random(-1.7, 1.7) * b.r, Random(6, 26) * k])
                Loop 3
                    b.drips.Push([Random(-0.6, 0.6) * b.r, Random(5, 12) * k, Random(0.7, 1.6)])
                st.blobs.Push(b)
            }
        case 4:
            st.slashes := []
            Loop 3 {
                a := (Random(-38, 38) + (Mod(A_Index, 2) ? 0 : 180)) * 0.01745
                px := W / 2 + Random(-0.18, 0.18) * W, py := H / 2 + Random(-0.14, 0.14) * H, L := 1.5 * W
                st.slashes.Push({sx: px - Cos(a) * L / 2, sy: py - Sin(a) * L / 2, dx: Cos(a), dy: Sin(a), L: L})
            }
        case 5:
            st.ox := W / 2 + Random(-120, 120) * k, st.oy := H / 2 + Random(-90, 90) * k
            st.cracks := []
            Loop 13 {
                a := (A_Index * 27.7 + Random(-9, 9)) * 0.01745, x := st.ox, y := st.oy
                pts := [x, y], total := 0, maxL := Random(0.22, 0.55) * W
                while (total < maxL) {
                    a += Random(-0.4, 0.4), sl := Random(28, 80) * k
                    x += Cos(a) * sl, y += Sin(a) * sl, total += sl
                    pts.Push(x, y)
                    if (Random(1, 100) <= 18) {
                        bx := x, by := y, ba := a + Random(-1.1, 1.1), bp := [bx, by]
                        Loop 3 {
                            ba += Random(-0.4, 0.4), bl := Random(18, 45) * k
                            bx += Cos(ba) * bl, by += Sin(ba) * bl
                            bp.Push(bx, by)
                        }
                        st.cracks.Push(bp)
                    }
                }
                st.cracks.Push(pts)
            }
    }
    KFState := st
    KFRender()
    KFGui.Show("x0 y0 w" W " h" H " NA")
    SetTimer(KFTick, 16)
}

KFTick() {
    global KFState, KFGui
    if (!IsObject(KFState) || A_TickCount - KFState.t0 > KFState.dur) {
        SetTimer(KFTick, 0)
        KFState := 0
        if (IsObject(KFGui))
            try KFGui.Hide()
        return
    }
    KFRender()
}

KFRender() {
    pc := A_IsCritical
    Critical
    try KFRenderInner()
    finally Critical(pc ? "On" : "Off")
}

KFEase(x) => 1 - (1 - Max(0.0, Min(1.0, x))) ** 3

KFRing(x, y, r, argb, wd) {
    global UG
    if (r > 0.5)
        DllCall("gdiplus\GdipDrawEllipse", "Ptr", UG, "Ptr", UPen(argb, wd), "Float", x - r, "Float", y - r, "Float", 2 * r, "Float", 2 * r)
}

; a filled polygon from a flat list of points [x1, y1, x2, y2, ...]
KFPoly(pts, argb) {
    global UG
    n := pts.Length // 2
    buf := Buffer(8 * n, 0)
    Loop n
        NumPut("Float", pts[2 * A_Index - 1], buf, (A_Index - 1) * 8), NumPut("Float", pts[2 * A_Index], buf, (A_Index - 1) * 8 + 4)
    DllCall("gdiplus\GdipFillPolygon", "Ptr", UG, "Ptr", UBrush(argb), "Ptr", buf, "Int", n, "Int", 0)
}

KFRenderInner() {
    global KFState, KFGui, KFS, UG, UAlpha, VigIntensity, HitKFCol
    st := KFState
    if (!IsObject(st) || !IsObject(KFGui))
        return
    UCacheTrim()
    W := st.W, H := st.H, k := st.k, cx := W / 2, cy := H / 2
    el := A_TickCount - st.t0, t := Min(1.0, el / st.dur)
    fade := (t < 0.55) ? 1.0 : Max(0.0, 1 - (t - 0.55) / 0.45)
    cs := KFHitCols(), c1 := cs[1], c2 := cs[2]
    C(c, a) => UC(c[1], c[2], c[3], Max(0, Min(255, Round(a))))
    prevG := UG, prevA := UAlpha
    UG := KFS.g, UAlpha := VigIntensity / 100
    DllCall("gdiplus\GdipGraphicsClear", "Ptr", UG, "UInt", 0)
    try {
        switch st.style {
            case 2:
                pop := KFEase(el / 140)
                gap := (16 + 26 * KFEase(t * 1.4)) * k, len := (36 + 10 * (1 - pop)) * k
                for d in [[1, 1], [1, -1], [-1, 1], [-1, -1]] {
                    x1 := cx + d[1] * gap * 0.707, y1 := cy + d[2] * gap * 0.707
                    x2 := x1 + d[1] * len * 0.707, y2 := y1 + d[2] * len * 0.707
                    ULine(x1, y1, x2, y2, C(c1, 130 * fade), 15 * k)
                    ULine(x1, y1, x2, y2, (el < 160) ? C(c1, 255 * fade) : C([255, 255, 255], 255 * fade), 5.5 * k)
                }
                KFRing(cx, cy, (18 + 120 * KFEase(el / 320)) * k, C(c2, 170 * (1 - KFEase(el / 320))), 3 * k)
                Loop 10 {
                    a := A_Index * 0.628 + 0.3, r := (30 + 150 * KFEase(el / 380)) * k
                    UDisc(cx + Cos(a) * r, cy + Sin(a) * r, 3 * k * (1 - t) + 0.5, C([255, 255, 255], 230 * (1 - t)))
                }
            case 3:
                g := KFEase(el / 90)
                cb := (HitKFCol = 1) ? [138, 0, 14] : KFShade(c1, -0.4)
                for b in st.blobs {
                    for sp in b.sats
                        UDisc(b.x + sp[1] * g, b.y + sp[2] * g, sp[3] * g, C(cb, 205 * fade))
                    UDisc(b.x, b.y, b.r * g, C(cb, 215 * fade))
                    for dr in b.drips {
                        L := b.r * (0.3 + 1.8 * t * dr[3])
                        URR(b.x + dr[1] - dr[2] / 2, b.y + b.r * 0.2, dr[2], L, dr[2] / 2, C(cb, 205 * fade))
                        UDisc(b.x + dr[1], b.y + b.r * 0.2 + L, dr[2] * 0.75, C(cb, 205 * fade))
                    }
                    UDisc(b.x - b.r * 0.3, b.y - b.r * 0.3, b.r * 0.22 * g, C([255, 255, 255], 36 * fade))
                }
            case 4:
                for j, sl in st.slashes {
                    p := KFEase((el - (j - 1) * 55) / 120)
                    if (p <= 0)
                        continue
                    ex := sl.sx + sl.dx * sl.L * p, ey := sl.sy + sl.dy * sl.L * p
                    mx := (sl.sx + ex) / 2, my := (sl.sy + ey) / 2, nx := -sl.dy, ny := sl.dx
                    for ly in [[30, c1, 60], [14, c2, 150], [5, [255, 255, 255], 255]] {
                        sw := ly[1] * k
                        KFPoly([sl.sx, sl.sy, mx + nx * sw, my + ny * sw, ex, ey, mx - nx * sw, my - ny * sw], C(ly[2], ly[3] * fade))
                    }
                }
            case 5:
                if (el < 130)
                    VigSolid(UG, 0, 0, W, H, C([255, 255, 255], 70 * (1 - el / 130)))
                p := KFEase(el / 150)
                KFRing(st.ox, st.oy, (10 + 40 * p) * k, C(c1, 200 * fade), 3 * k)
                for cr in st.cracks {
                    n := cr.Length // 2 - 1, upto := n * p
                    Loop n {
                        i := A_Index
                        if (i > upto + 1)
                            break
                        f := Min(1.0, upto - (i - 1))
                        x1 := cr[2 * i - 1], y1 := cr[2 * i], x2 := x1 + (cr[2 * i + 1] - x1) * f, y2 := y1 + (cr[2 * i + 2] - y1) * f
                        ULine(x1, y1, x2, y2, C(c1, 80 * fade), 7 * k)
                        ULine(x1, y1, x2, y2, C([255, 255, 255], 230 * fade), 2 * k)
                    }
                }
            case 6:
                if (!IsObject(st.lines) || el // 45 != st.lineAt) {
                    st.lineAt := el // 45, st.lines := []
                    Loop 80
                        st.lines.Push([Random(0.0, 6.2832), Random(0.25, 0.42), Random(4, 15) * k, Mod(A_Index, 3) = 0])
                }
                ro := Sqrt(W * W + H * H) / 2 + 20
                ia := Min(1.0, el / 60) * fade
                for ln in st.lines {
                    dx := Cos(ln[1]), dy := Sin(ln[1]), ri := ln[2] * Min(W, H)
                    KFPoly([cx + dx * ri, cy + dy * ri, cx + dx * ro - dy * ln[3], cy + dy * ro + dx * ln[3], cx + dx * ro + dy * ln[3], cy + dy * ro - dx * ln[3]]
                        , ln[4] ? C(c1, 170 * ia) : C([255, 255, 255], 150 * ia))
                }
                UDisc(cx, cy, 70 * k * (1 - t), C([255, 255, 255], 90 * Max(0, 1 - t * 2)))
            case 7:
                Loop 3 {
                    e := KFEase((el - (A_Index - 1) * 90) / (st.dur * 0.8))
                    if (e <= 0)
                        continue
                    R := e * 0.75 * W
                    KFRing(cx, cy, R, C(c1, 70 * (1 - e)), 26 * k)
                    KFRing(cx, cy, R, C(c2, 160 * (1 - e)), 9 * k)
                    KFRing(cx, cy, R, C([255, 255, 255], 220 * (1 - e)), 2.5 * k)
                }
                UDisc(cx, cy, 90 * k * (1 - t), C([255, 255, 255], 130 * Max(0, 1 - t * 3)))
            case 8:
                ins := (14 + 60 * (1 - KFEase(el / 160))) * k
                Loop 6 {
                    j := A_Index * 2
                    URRLine(ins - j, ins - j, W - 2 * ins + 2 * j, H - 2 * ins + 2 * j, 18 * k + j, C(c1, (80 - A_Index * 12) * fade))
                }
                URRLine(ins, ins, W - 2 * ins, H - 2 * ins, 18 * k, C([255, 255, 255], 210 * fade))
                bl := 80 * k, bi := ins + 10 * k
                for q in [[bi, bi, 1, 1], [W - bi, bi, -1, 1], [bi, H - bi, 1, -1], [W - bi, H - bi, -1, -1]] {
                    ULine(q[1], q[2], q[1] + q[3] * bl, q[2], C(c2, 255 * fade), 5 * k)
                    ULine(q[1], q[2], q[1], q[2] + q[4] * bl, C(c2, 255 * fade), 5 * k)
                }
                sy := H * KFEase(el / (st.dur * 0.7))
                VigGradRect(UG, 0, Round(sy - 40 * k), W, Round(40 * k), C(c1, 0), C(c1, 90 * fade), 1)
        }
    }
    UG := prevG, UAlpha := prevA
    ULayered(KFGui.Hwnd, KFS.dc, W, H)
}

