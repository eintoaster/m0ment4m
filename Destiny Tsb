        SavedExt3Checked := IsExtender3Checked
        SavedExt4Checked := IsExtender4Checked
        SavedBD1Checked  := IsBD1Checked
        SavedBD2Checked  := IsBD2Checked
        SavedBD3Checked  := IsBD3Checked
        SavedBD4Checked  := IsBD4Checked
