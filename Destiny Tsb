    WMousePart("XButton1", ox - 9, oy + 122, 12, 24, 6, 2, 2, 6, gst, 0.9)
    UText("M5", ox - 40, oy + 92, UCol("Text2"), F_Tiny, 28, 24, 2, 1)
    UText("M4", ox - 40, oy + 122, UCol("Text2"), F_Tiny, 28, 24, 2, 1)
}

; the camera turn: the last 4 s of side-to-side mouse movement in degrees per second (right up, left down)
WDrawTurn(wd) {
    global WTurnHist, F_B, F_Sm, F_Tiny
    W := wd.w, H := wd.h
    gst := GradStops(wd.grad)
    now := A_TickCount
    UText("Camera turn", 16, 10, UCol("Text"), F_B, 160, 22, 0, 1)
    px := 16, py := 40, pw := W - 32, ph := 74
    mid := py + ph / 2
    hist := WTurnHist, n := hist.Length
    hi := 180
    for v in hist
        hi := Max(hi, Abs(v))
    last := n ? hist[n] : 0
    ; live value + which way
    dirTxt := Abs(last) < 20 ? "" : (last > 0 ? Chr(0x2192) " right" : Chr(0x2190) " left")
    c := GradSample(gst, now / 1000 * 0.2)
    UText(Round(Abs(last)) " deg/s", W - 180, 10, Abs(last) < 20 ? UCol("Muted") : UC(c[1], c[2], c[3]), F_Sm, 164, 22, 2, 1)
    if (dirTxt != "")
        UText(dirTxt, W - 180, 26, UCol("Text2"), F_Tiny, 164, 14, 2, 1)
    URR(px, py, pw, ph, 8, UCol("Pill", 160))
    ULine(px + 4, mid, px + pw - 4, mid, UCol("Border"))
    UText("right", px + pw - 44, py + 2, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
    UText("left", px + pw - 44, py + ph - 16, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
    if (n >= 2) {
        pts := []
        Loop n {
            i := A_Index
            a := hist[Max(1, i - 1)], b := hist[i], cc := hist[Min(n, i + 1)]
            v := (a + b + cc) / 3
            pts.Push([px + pw * (100 - n + i - 1) / 99, mid - v / hi * (ph / 2 - 6)])
        }
        UGraphArea(pts, n, mid, px, pw, gst, now / 1000 * 0.15)
        UGraphLine(pts, n, px, pw, gst, now / 1000 * 0.15, 6, 0.22)
        UGraphLine(pts, n, px, pw, gst, now / 1000 * 0.15, 2.2, 1.0)
        lp := pts[n]
        UDisc(lp[1], lp[2], 5, UC(c[1], c[2], c[3], 60))
        UDisc(lp[1], lp[2], 3, UC(255, 255, 255))
    }
    UText("-4s", px, py + ph + 2, UCol("Muted"), F_Tiny, 40, 14, 0, 1)
    UText("now", px + pw - 40, py + ph + 2, UCol("Muted"), F_Tiny, 40, 14, 2, 1)
}

WDragTick() {
    global Widgets, WDrag, isAppMinimized
    static wasDown := false
    menuOpen := !isAppMinimized
    for id, wd in Widgets {
        if (!wd.visible || !IsObject(wd.gui))
            continue
        if (menuOpen = wd.thru) {
            wd.thru := !menuOpen
            try WinSetExStyle(menuOpen ? "-0x20" : "+0x20", "ahk_id " wd.gui.Hwnd)
        }
    }
    if (!menuOpen) {
        WDrag := 0, wasDown := false
        return
    }
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    mx := NumGet(pt, 0, "Int"), my := NumGet(pt, 4, "Int")
    down := (DllCall("GetAsyncKeyState", "Int", 1, "Short") & 0x8000) != 0
    if (IsObject(WDrag)) {
        wd := WDrag.wd
        if (down) {
            wd.gui.Move(Max(0, Min(A_ScreenWidth - WPx(wd, wd.w), mx - WDrag.ox)), Max(0, Min(A_ScreenHeight - WPx(wd, wd.h), my - WDrag.oy)))
        } else {
            wd.gui.GetPos(&gx, &gy)
            wd.x := gx, wd.y := gy, wd.custom := true
            WDrag := 0
            USavePrefs()
        }
        WRender(wd)
    } else if (down && !wasDown) {
        hw := DllCall("WindowFromPoint", "Int64", (mx & 0xFFFFFFFF) | (my << 32), "Ptr")
        for id, wd in Widgets {
            if (wd.visible && IsObject(wd.gui) && hw = wd.gui.Hwnd) {
                wd.gui.GetPos(&gx, &gy)
                WDrag := {wd: wd, ox: mx - gx, oy: my - gy}
                WRender(wd)
                break
            }
        }
    }
    wasDown := down
}

