UCardEnd() {
    global UCY, UCardTop, UCardId, UCardH, UAnimating
    UCY += 8
    h := UCY - UCardTop
    if (!UCardH.Has(UCardId))
        UAnimSet("ch" UCardId, h)
    if (UCardH.Get(UCardId, 0) != h) {
        UCardH[UCardId] := h
        UAnimating := true
    }
    UCY := UCardTop + h + 16
}

